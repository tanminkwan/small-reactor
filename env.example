# GPU 설정
USE_GPU=true
CUDA_VISIBLE_DEVICES=0

# 모델 경로 설정
BUFFALO_L_MODEL_PATH=models/buffalo_l
INSWAPPER_MODEL_PATH=models/inswapper_128.onnx
CODEFORMER_MODEL_PATH=models/codeformer-v0.1.0.pth
INPAINT_MODEL_PATH=TheImposterImposters/URPM-SD1.5-v2.3.inpainting

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Gradio 설정
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# 성능 설정
MAX_IMAGE_SIZE=1024
BATCH_SIZE=1

# 결과 이미지 저장 경로 설정
OUTPUT_PATH=C:\\Users\\tanmi\\stable-diffusion-webui\\outputs\\small_reactor

# Inpainting 결과 이미지 저장 경로 설정
INPAINT_OUTPUT_PATH=C:\\Users\\tanmi\\stable-diffusion-webui\\outputs\\small_reactor\\inpaint

# 얼굴 임베딩 저장 경로 설정
FACES_PATH=./faces

# 이미지 결합 결과 저장 경로 설정
IMAGE_BLEND_OUTPUT_PATH=C:\\Users\\tanmi\\stable-diffusion-webui\\outputs\\small_reactor\\image_blend